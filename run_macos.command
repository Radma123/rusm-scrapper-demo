#!/bin/bash

# Переходим в директорию, где лежит сам этот файлик
cd "$(dirname "$0")"

echo "==================================================="
echo "[Launcher] Проверка зависимостей и запуск проекта..."
echo "==================================================="

# 1. Проверяем и устанавливаем requirements.txt
echo "[1/3] Проверка пакетов из requirements.txt..."
python3 -m pip install --upgrade pip
python3 -m pip install -r requirements.txt
if [ $? -ne 0 ]; then
    echo "[Ошибка] Не удалось установить зависимости."
    exit 1
fi

# 2. Открываем браузер через 2 секунды в фоновом режиме
echo "[2/3] Подготовка к открытию браузера..."
(sleep 2 && open "http://localhost:6767") &

# 3. Запускаем проект
echo "[3/3] Запуск сервера Uvicorn..."
echo "---------------------------------------------------"
python3 main.py